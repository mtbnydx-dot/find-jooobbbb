[Unit]
Description=Job Tracker Isolated Preview
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=job-tracker
Group=job-tracker
WorkingDirectory=/opt/job-tracker-preview/current
Environment=NODE_ENV=production
Environment=BIND_HOST=127.0.0.1
Environment=PORT=3101
Environment=DATA_DIR=/opt/job-tracker-preview/data
Environment=CLOUD_SCHEDULER=0
Environment=PRODUCT_PUBLIC_BASE=/usertest
Environment=OPS_PUBLIC_BASE=/test
Environment=PRODUCT_COOKIE_NAME=job_usertest_session
Environment=LEGACY_ADMIN_ONLY=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/job-tracker-preview/.playwright-browsers
Environment=HOME=/opt/job-tracker-preview/data/browser-home
EnvironmentFile=/etc/job-tracker-preview.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/job-tracker-preview/data

[Install]
WantedBy=multi-user.target
