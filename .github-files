# ===== 排除（敏感/本地/缓存） =====
# local/config.json          # 真实 token + 服务器 IP
# local/.last_push.json      # 本地同步状态
# server/data/               # 运行时数据
# node_modules/              # 依赖
# deploy/.deploy-tmp/        # 部署临时文件
# deploy/test-backup.xlsx    # 测试残留
